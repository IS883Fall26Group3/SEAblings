# Copy to .streamlit/secrets.toml for local use (gitignored).
# On Streamlit Cloud, paste these into App settings > Secrets.
GEMINI_API_KEY = ""
RAPIDAPI_KEY = ""          # JSearch on RapidAPI
JOB_SOURCE = "jsearch"     # "jsearch" or "sample" (offline demo)
# JSEARCH_URL = "https://jsearch.p.rapidapi.com/search-v2"  # copy from the RapidAPI playground if it differs

# Gemini models shown in the sidebar, in Auto-mode order. Each has its own free daily quota.
# Use names listed in Google AI Studio.
GEMINI_MODELS = "gemini-flash-latest,gemini-flash-lite-latest"
# GEMINI_EMBED_MODEL = "gemini-embedding-001"

# Offline GGUF models from Hugging Face, run with llama-cpp-python (defaults shown)
# LOCAL_LLM_REPO = "bartowski/Llama-3.2-1B-Instruct-GGUF"
# LOCAL_LLM_FILE = "*Q4_K_M.gguf"
# LOCAL_EMBED_REPO = "CompendiumLabs/bge-small-en-v1.5-gguf"
# LOCAL_EMBED_FILE = "*q8_0.gguf"
# EMBEDDINGS = "auto"      # "auto" = local if available, else Gemini; or "local" / "gemini"
