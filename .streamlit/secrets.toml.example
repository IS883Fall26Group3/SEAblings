# Copy to .streamlit/secrets.toml for local use (gitignored).
# On Streamlit Cloud, paste these into App settings > Secrets.
GEMINI_API_KEY = ""
RAPIDAPI_KEY = ""          # JSearch on RapidAPI
JOB_SOURCE = "jsearch"     # "jsearch" or "sample" (offline demo)
# JSEARCH_URL = "https://jsearch.p.rapidapi.com/search-v2"  # copy from the RapidAPI playground if it differs

# Gemini models shown in the sidebar, in Auto-mode order. Each has its own free daily quota.
# Use names listed in Google AI Studio. Flash Lite first: every eval ran on it and it answers in
# seconds. gemini-3.5-flash instead of gemini-flash-latest, which points to the newest Flash
# (20 free requests a day, often overloaded: 503 / 504).
GEMINI_MODELS = "gemini-flash-lite-latest,gemini-3.5-flash"
# GEMINI_EMBED_MODEL = "gemini-embedding-001"

# Offline GGUF models from Hugging Face, run with llama-cpp-python (defaults shown)
# LOCAL_LLM_REPO = "bartowski/Llama-3.2-1B-Instruct-GGUF"
# LOCAL_LLM_FILE = "*Q4_K_M.gguf"
# LOCAL_EMBED_REPO = "CompendiumLabs/bge-small-en-v1.5-gguf"
# LOCAL_EMBED_FILE = "*q8_0.gguf"
# EMBEDDINGS = "auto"      # "auto" = Gemini if GEMINI_API_KEY is set, else local; or "local" / "gemini"
# EXPERIENCE_FIT = "judge"  # "judge" (relevant roles by LLM, +1 call per search), "roles" (embedding) or "total" (all years)
# PROFILE_SIMILARITY = "document"  # "document" (whole CV vs posting), "summary" (LLM summaries) or "chunks"
# REQUIREMENT_LABELS = "llm"  # "llm" (retrieval + met/partial/missing with quotes, +1 call per search) or "match" (by name and embedding)
